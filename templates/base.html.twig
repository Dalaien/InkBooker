{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}InkBooker{% endblock %}</title>

    {# Chargement du CSS global #}
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">

    {% block stylesheets %}{% endblock %}
    {% block javascripts %}{% endblock %}
</head>
<body>

<header class="site-header">
    <div class="container header-container">
        <div class="header-left">
            <div class="logo">InkBooker</div>
            <nav class="nav">
                <a href="{{ path('app_home') }}" class="nav-link active">Accueil</a>
                <a href="#" class="nav-link">Services</a>
                <a href="#" class="nav-link">Artistes</a>
                <a href="#" class="nav-link">Contact</a>
            </nav>
        </div>
        <div class="header-right">
            <a class="btn btn-login" href="#">Se connecter</a>
            <a class="btn btn-primary" href="#">Prendre rendez-vous</a>
        </div>
    </div>
</header>

<main class="container main-content">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert">{{ message|raw }}</div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<footer class="site-footer">
    <div class="container footer-grid">
        <div class="footer-section">
            <h4>A propos</h4>
            <p class="muted">Planifiez vos rendez-vous en ligne avec nos artistes.</p>
        </div>
        <div class="footer-section">
            <h4>Liens utiles</h4>
            <ul class="list-clean">
                <li><a class="link" href="#">FAQ</a></li>
                <li><a class="link" href="#">Politique de confidentialité</a></li>
            </ul>
        </div>
        <div class="footer-section">
            <h4>Contact</h4>
            <ul class="list-clean muted">
                <li>contact@inkbooker.test</li>
                <li>+33 6 00 00 00 00</li>
            </ul>
        </div>
        <div class="footer-section">
            <h4>Suivez-nous</h4>
            <div class="socials">
                <span class="network">IG</span>
                <span class="network">FB</span>
                <span class="network">X</span>
            </div>
        </div>
    </div>
</footer>

</body>
</html>
